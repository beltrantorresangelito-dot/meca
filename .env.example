# PostgreSQL: use una de estas dos alternativas.
DATABASE_URL=postgresql://usuario:password@localhost:5433/meca_db
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=postgres
# DB_PASSWORD=CAMBIAR
# DB_NAME=meca_db

# Seguridad: mínimo 32 caracteres aleatorios. NO versionar el valor real.
AUTH_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Solo si el frontend realmente llama al backend desde otro origen.
# Separar múltiples orígenes con coma.
CORS_ORIGINS=http://localhost:8080
